{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/speak-human/activation-case.schema.json",
  "title": "Speak Human activation case suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "suite",
    "description",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "activation"
    },
    "suite": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "addedAt",
        "origin",
        "locale",
        "surface",
        "tags",
        "request",
        "context",
        "expectedActivation",
        "rationale",
        "safetyImpact",
        "supersedes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^sh_act_[a-z0-9_]+$"
        },
        "status": {
          "enum": [
            "candidate",
            "accepted",
            "retired"
          ]
        },
        "addedAt": {
          "type": "string",
          "format": "date"
        },
        "acceptedAt": {
          "type": "string",
          "format": "date"
        },
        "retiredAt": {
          "type": "string",
          "format": "date"
        },
        "retirementReason": {
          "type": "string",
          "minLength": 1
        },
        "replacedBy": {
          "type": "string",
          "pattern": "^sh_act_[a-z0-9_]+$"
        },
        "duplicateOf": {
          "type": "string",
          "pattern": "^sh_act_[a-z0-9_]+$"
        },
        "origin": {
          "enum": [
            "synthetic",
            "real-redacted",
            "regression"
          ]
        },
        "locale": {
          "enum": [
            "zh-CN",
            "en"
          ]
        },
        "surface": {
          "enum": [
            "marketing",
            "product-workflow",
            "admin-ops",
            "developer-tool",
            "frontend-style-only",
            "backend",
            "technical-docs",
            "generic-prose",
            "mixed",
            "localization"
          ]
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          }
        },
        "request": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "expectedActivation": {
          "enum": [
            "yes",
            "no",
            "review"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "safetyImpact": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sh_act_[a-z0-9_]+$"
          }
        }
      }
    }
  }
}
